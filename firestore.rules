rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidSkin(skin) {
      return skin is string && skin.size() <= 40 && (
        skin == 'wikimedia-classic' ||
        skin == 'anime-sakura' ||
        skin == 'anime-mecha' ||
        skin == 'anime-shinkai' ||
        skin == 'anime-forest' ||
        skin == 'anime-royal'
      );
    }

    // 3. Entity Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'preferredSkin', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'role', 'preferredSkin', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.role is string && data.role.size() <= 32 && data.role == 'editor'
        && isValidSkin(data.preferredSkin)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.updatedAt is timestamp;
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll([
          'logId', 'ownerId', 'action', 'title', 'lang',
          'newLinks', 'contaminationsFixed', 'note', 'wikitext',
          'timestampDisplay', 'createdAt'
        ])
        && data.keys().hasOnly([
          'logId', 'ownerId', 'action', 'title', 'lang',
          'newLinks', 'contaminationsFixed', 'note', 'wikitext',
          'timestampDisplay', 'createdAt'
        ])
        && isValidId(data.logId)
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.action is string && data.action.size() >= 1 && data.action.size() <= 120
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.lang is string && data.lang.size() >= 1 && data.lang.size() <= 16
        && (data.newLinks is int || data.newLinks is number) && data.newLinks >= 0 && data.newLinks <= 10000
        && (data.contaminationsFixed is int || data.contaminationsFixed is number) && data.contaminationsFixed >= 0 && data.contaminationsFixed <= 10000
        && data.note is string && data.note.size() <= 500
        && data.wikitext is string && data.wikitext.size() <= 50000
        && data.timestampDisplay is string && data.timestampDisplay.size() >= 1 && data.timestampDisplay.size() <= 100
        && data.createdAt is timestamp;
    }

    // 4. Collection: /users/{userId}
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().role == existing().role
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Update Profile & Preferred Skin
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'preferredSkin', 'updatedAt'])
        );

      allow delete: if false;

      // 5. Subcollection: /users/{userId}/private/{infoId} (PII Isolation)
      match /private/{infoId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(infoId) && infoId == 'info';
        allow list: if false;

        allow create: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(infoId)
          && infoId == 'info'
          && isValidUserPrivateInfo(incoming())
          && incoming().updatedAt == request.time
          && (
            exists(/databases/$(database)/documents/users/$(userId)) ||
            existsAfter(/databases/$(database)/documents/users/$(userId))
          );

        allow update: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(infoId)
          && infoId == 'info'
          && isValidUserPrivateInfo(incoming())
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && (
            // Action: Sync Verified Email
            incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt'])
          )
          && exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if false;
      }

      // 6. Subcollection: /users/{userId}/activityLogs/{logId}
      match /activityLogs/{logId} {
        allow get: if isOwner(userId)
          && isValidId(userId)
          && isValidId(logId)
          && (resource == null || existing().ownerId == request.auth.uid)
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if isOwner(userId)
          && resource.data.ownerId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(logId)
          && isValidActivityLog(incoming())
          && incoming().logId == logId
          && incoming().createdAt == request.time
          && (
            exists(/databases/$(database)/documents/users/$(userId)) ||
            existsAfter(/databases/$(database)/documents/users/$(userId))
          );

        allow update: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(logId)
          && isValidActivityLog(incoming())
          && incoming().logId == existing().logId
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == request.time
          && (
            // Action: Sync Activity Log Snapshot
            incoming().diff(existing()).affectedKeys().hasOnly([
              'action', 'title', 'lang', 'newLinks', 'contaminationsFixed',
              'note', 'wikitext', 'timestampDisplay', 'createdAt'
            ])
          )
          && exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(logId)
          && existing().ownerId == request.auth.uid
          && exists(/databases/$(database)/documents/users/$(userId));
      }
    }
  }
}
